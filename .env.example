# AJS Pantry Environment Configuration Template
# Copy this file to '.env' and fill in your local or production values.
# DO NOT COMMIT YOUR REAL '.env' FILE TO GIT!

# Flask App Configuration
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate_a_secure_random_string_here
SESSION_SECRET=generate_a_secure_random_string_here

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_ID.supabase.co:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_ID.supabase.co:5432/postgres

# Supabase API Credentials
SUPABASE_URL=https://YOUR_SUPABASE_ID.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_CLAIMS_SUB=mailto:admin@example.com

# Internal Security & API Secrets
INTERNAL_API_SECRET=your_internal_api_secret_key
